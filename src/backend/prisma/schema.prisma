generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Person {
  id        Int      @id @default(autoincrement())
  name      String
  birthDate String?
  parentId  Int?
  parent2Id Int?
  parent    Person?  @relation("Parent1", fields: [parentId], references: [id])
  parent2   Person?  @relation("Parent2", fields: [parent2Id], references: [id])
  children  Person[] @relation("Parent1")
  children2 Person[] @relation("Parent2")
  photoUrl  String?
  createdAt DateTime @default(now())
  audios    Audio[]
}

model Audio {
  id        Int      @id @default(autoincrement())
  personId  Int
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  createdAt DateTime @default(now())
}